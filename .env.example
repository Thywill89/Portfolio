# Formspree form ID (https://formspree.io) — required for the contact form
# Create a form, then paste the ID from https://formspree.io/f/xxxxxxxx
VITE_FORMSPREE_ID=

# Optional: site URL used in Open Graph / canonical (no trailing slash)
VITE_SITE_URL=https://your-domain.vercel.app

# Optional analytics — leave blank until you are ready
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Plausible data-domain, e.g. thywill.dev
VITE_PLAUSIBLE_DOMAIN=
